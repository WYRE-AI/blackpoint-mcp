# CompassOne API token. Required for the stdio transport.
# In AUTH_MODE=gateway the token arrives on X-Blackpoint-API-Token instead,
# and the server does not fall back to this variable.
BLACKPOINT_API_TOKEN=

# Optional CompassOne base URL. The live and legacy hosts normalize to
# https://api.blackpointcyber.com/v1.
# BLACKPOINT_BASE_URL=

# stdio (default) or http. The S2S secret is required only for http.
# MCP_TRANSPORT=stdio

# HTTP listen port. Default: 8080.
# MCP_HTTP_PORT=8080

# HTTP bind address. Default when unset: 127.0.0.1.
# The container image sets 0.0.0.0 and still requires CONDUIT_S2S_SECRET.
# MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty. Never commit a real value, and the server
# never prints it.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. Startup logs a warning and /mcp does not check
# X-Gateway-S2S. Any other value is ignored.
# MCP_ALLOW_INSECURE_DEV=1

# Set to gateway so /mcp requires X-Blackpoint-API-Token on each request.
# AUTH_MODE=gateway

# debug, info, warn, or error. Default: info.
# The insecure-dev startup warning is printed even when this is error.
# LOG_LEVEL=info
